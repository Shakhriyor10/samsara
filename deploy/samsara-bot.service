[Unit]
Description=Samsara Telegram safety and PTI bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=samsara
Group=samsara
WorkingDirectory=/opt/samsara/app
EnvironmentFile=/etc/samsara-bot.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/samsara/venv/bin/python -u /opt/samsara/app/main.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/samsara

[Install]
WantedBy=multi-user.target
