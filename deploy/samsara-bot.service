[Unit]
Description=Samsara Telegram safety and PTI bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=samsara
Group=samsara
WorkingDirectory=/var/www/samsara
EnvironmentFile=/etc/samsara-bot.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/var/www/samsara/.venv/bin/python -u /var/www/samsara/main.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/samsara

[Install]
WantedBy=multi-user.target
