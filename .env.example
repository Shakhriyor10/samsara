# Copy this file to .env and fill in the values below.
# Never commit or share your populated .env file.

# API token for the first Samsara organization. Video requires Safety Events and Media Retrieval;
# driver/telematics overlays also use Read Drivers, Read Assignments, and Read Vehicle Statistics.
API_KEY=

# Optional API token for a second Samsara organization. Its trucks are included
# in group setup, and requests are sent to the corresponding Samsara API.
API_KEY2=

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Telegram ID of the primary bot administrator. Separate multiple IDs with commas.
# Run /myid after starting the bot to find your ID.
BOT_ADMIN_IDS=

# Optional settings (defaults are usually fine).
POLL_INTERVAL_SECONDS=30
INITIAL_LOOKBACK_MINUTES=10
LOG_LEVEL=INFO

# The bot displays all dates and times in New York, including daylight-saving changes.
EVENT_TIMEZONE=America/New_York

# Number of days to search with /history.
HISTORY_LOOKBACK_DAYS=6

# Overlay the driver, truck, location, speed, and speed graph on videos.
# Videos are re-encoded in high quality when this is enabled.
VIDEO_TELEMATICS_OVERLAY=true

# Telegram Mini App. WEBAPP_URL must be the public HTTPS address that serves this app.
WEBAPP_URL=https://your-domain.example/
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
